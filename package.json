{
  "name": "x-agent-relay",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "relay": "node apps/relay-server/dist/index.js",
    "agent": "node apps/cli/dist/index.js",
    "demo": "node scripts/demo.mjs",
    "verify:cloud": "node scripts/verify-cloudflare.mjs",
    "deploy:cloud": "npm run deploy -w @x-agent-relay/relay-worker",
    "publish:cli": "npm run build && npm run bundle -w x-agent-relay-cli && npm publish -w x-agent-relay-cli"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
